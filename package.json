{
  "name": "readmebot",
  "version": "0.0.0-releaseit",
  "description": "AI-powered README generator for GitHub repositories",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "dist/src",
    "bin": "dist/bin"
  },
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "start": "tsx ./src/index.ts",
    "build": "rm -rf ./dist && tsc && tsc-alias && chmod +x ./dist/bin/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "release": "release-it --ci --config .release-it.js"
  },
  "bin": {
    "readmebot": "dist/bin/index.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "@tsconfig/node20": "^20.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "release-it": "^17.3.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.18.0",
    "@langchain/anthropic": "^0.0.10",
    "@langchain/community": "^0.0.28",
    "@langchain/core": "^0.1.48",
    "@langchain/openai": "^0.0.14",
    "@types/pino": "^7.0.4",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.1",
    "openai": "^4.28.4",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.21.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesvillarrubia/readmebot.git"
  },
  "keywords": [
    "pull requests",
    "github",
    "automation",
    "prs",
    "ai",
    "readme",
    "documentation"
  ],
  "author": {
    "name": "James Villarrubia",
    "email": "james.villarrubia@gmail.com"
  },
  "contributors": [
    {
      "name": "James Villarrubia",
      "email": "james.villarrubia@gmail.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jamesvillarrubia/readmebot/issues"
  },
  "homepage": "https://github.com/jamesvillarrubia/readmebot#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}